# Copy this file to .env and fill in what you have. Never commit .env.
# With no NEWS_API_KEY the app runs in DEMO MODE on the saved class snapshots.
NEWS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional: comma-separated ElevenLabs voice IDs (first = anchor, rest = desks)
ELEVENLABS_VOICES=

# Switches
DEMO_MODE=false          # true = never call NewsAPI, even with a key
ENABLE_ZSC=true          # zero-shot sentiment (needs requirements-zsc.txt)
ENABLE_LIVE_STOCKS=true
SAVE_SNAPSHOTS=true      # archive every live fetch for the Echo Index
PORT=8080
DASH_DEBUG=false
